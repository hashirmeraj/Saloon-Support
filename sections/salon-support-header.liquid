{%- comment -%}
  ============================================================
  SALON SUPPORT RESPONSIVE HEADER
  Self-contained Shopify Online Store 2.0 section
  ============================================================

  Features:
  - Responsive desktop / tablet / mobile header
  - Editable logo
  - Functional Shopify search
  - Dynamic cart count
  - Wishlist button
  - Customer login/account state
  - Account dropdown
  - Dynamic Shopify navigation menu
  - Desktop dropdown / mega-menu support
  - Mobile navigation drawer
  - Optional sticky header
  - Fully scoped CSS
  - Vanilla JavaScript only
{%- endcomment -%}

{%- liquid
  assign section_id = 'SalonHeader-' | append: section.id
  assign main_menu = section.settings.menu
-%}

<header
  id="{{ section_id }}"
  class="ss-header{% if section.settings.enable_sticky %} ss-header--sticky{% endif %}"
  style="
    --ss-max-width: {{ section.settings.max_width }}px;
    --ss-top-height: {{ section.settings.desktop_top_height }}px;
    --ss-nav-height: {{ section.settings.desktop_nav_height }}px;

    --ss-side-padding: {{ section.settings.desktop_side_padding }}px;
    --ss-mobile-side-padding: {{ section.settings.mobile_side_padding }}px;

    --ss-search-width: {{ section.settings.search_width }}px;
    --ss-logo-width: {{ section.settings.logo_width }}px;

    --ss-bg: {{ section.settings.background_color }};
    --ss-text: {{ section.settings.text_color }};
    --ss-muted: {{ section.settings.muted_text_color }};
    --ss-border: {{ section.settings.border_color }};
    --ss-hover: {{ section.settings.hover_color }};
    --ss-heart: {{ section.settings.heart_color }};
    --ss-focus-ring: {{ section.settings.focus_ring_color }};
    --ss-dropdown-bg: {{ section.settings.dropdown_background }};
  "
>
  <div class="ss-header__desktop">
    <div class="ss-header__top">
      <div class="ss-header__top-inner">

        {%- comment -%}
          LEFT — SEARCH
        {%- endcomment -%}
        <div class="ss-header__search-wrap">
          <form
            action="{{ routes.search_url }}"
            method="get"
            role="search"
            class="ss-search"
          >
            <div class="ss-search__field">
              <input
                class="ss-search__input"
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="{{ section.settings.search_placeholder | escape }}"
                aria-label="{{ section.settings.search_placeholder | escape }}"
                autocomplete="off"
              >

              <button
                class="ss-search__submit"
                type="submit"
                aria-label="Search"
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  focusable="false"
                >
                  <circle cx="11" cy="11" r="6.5"></circle>
                  <path d="M16 16L21 21"></path>
                </svg>
              </button>
            </div>

            {% if section.settings.search_helper != blank %}
              <p class="ss-search__helper">
                {{ section.settings.search_helper }}
              </p>
            {% endif %}
          </form>
        </div>


        {%- comment -%}
          CENTER — LOGO
        {%- endcomment -%}
        <div class="ss-header__logo-wrap">
          <a
            href="{{ routes.root_url }}"
            class="ss-logo"
            aria-label="{{ shop.name | escape }}"
          >
            {% if section.settings.logo != blank %}
              {{
                section.settings.logo
                | image_url: width: 600
                | image_tag:
                  class: 'ss-logo__image',
                  widths: '120, 160, 200, 240, 300, 400, 500, 600',
                  loading: 'eager',
                  alt: shop.name
              }}
            {% else %}
              <span class="ss-logo__placeholder">
                {{ section.settings.logo_text }}
              </span>
            {% endif %}
          </a>
        </div>


        {%- comment -%}
          RIGHT — ACTIONS
        {%- endcomment -%}
        <div class="ss-header__actions">

          {% if section.settings.show_wishlist %}
            <a
              href="{{ section.settings.wishlist_link | default: routes.root_url }}"
              class="ss-action ss-action--wishlist"
              aria-label="{{ section.settings.wishlist_label | escape }}"
            >
              <span>{{ section.settings.wishlist_label }}</span>

              <svg
                class="ss-action__heart"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M12 21s-7.2-4.5-9.5-8.5C.5 9 2 5.2 5.5 4.2A5.4 5.4 0 0 1 12 6.8a5.4 5.4 0 0 1 6.5-2.6c3.5 1 5 4.8 3 8.3C19.2 16.5 12 21 12 21Z"
                  fill="currentColor"
                />
              </svg>
            </a>
          {% endif %}


          {% if section.settings.show_cart %}
            <a
              href="{{ routes.cart_url }}"
              class="ss-action ss-action--cart"
              aria-label="Cart, {{ cart.item_count }} items"
            >
              <svg
                class="ss-action__cart-icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M7 8h10l1 12H6L7 8Z"></path>
                <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
              </svg>

              <span
                class="ss-action__cart-count"
                aria-hidden="true"
              >
                {{ cart.item_count }}
              </span>
            </a>
          {% endif %}


          {% if section.settings.show_account %}
            <details class="ss-account" data-ss-account>
              <summary class="ss-action ss-action--account">
                <span>
                  {% if customer %}
                    {{ section.settings.account_logged_in_label }}
                  {% else %}
                    {{ section.settings.account_logged_out_label }}
                  {% endif %}
                </span>

                {% unless customer %}
                  <svg
                    class="ss-action__user-icon"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="7.5" r="4"></circle>
                    <path d="M5 21c.4-4.5 3-7 7-7s6.6 2.5 7 7"></path>
                  </svg>
                {% endunless %}

                <svg
                  class="ss-action__caret"
                  viewBox="0 0 10 6"
                  aria-hidden="true"
                >
                  <path d="M1 1l4 4 4-4"></path>
                </svg>
              </summary>

              <div class="ss-account__menu">
                {% if customer %}
                  <a href="{{ routes.account_url }}">Account Home</a>
                  <a href="{{ routes.account_url }}">Orders</a>

                  {% if section.settings.show_invoice_link %}
                    <a href="{{ section.settings.invoice_link | default: routes.account_url }}">
                      Pay Invoices
                    </a>
                  {% endif %}

                  {% if section.settings.show_reorder_link %}
                    <a href="{{ section.settings.reorder_link | default: routes.account_url }}">
                      Reorder
                    </a>
                  {% endif %}

                  {% if section.settings.show_account_wishlist %}
                    <a href="{{ section.settings.wishlist_link | default: routes.root_url }}">
                      Wishlists
                    </a>
                  {% endif %}

                  <span class="ss-account__divider"></span>

                  <a href="{{ routes.account_logout_url }}">
                    Log Out
                  </a>
                {% else %}
                  <a href="{{ routes.account_login_url }}">
                    Log In
                  </a>

                  <a href="{{ routes.account_register_url }}">
                    Create Account
                  </a>
                {% endif %}
              </div>
            </details>
          {% endif %}

        </div>
      </div>
    </div>


    {%- comment -%}
      DESKTOP NAVIGATION
    {%- endcomment -%}
    {% if main_menu != blank %}
      <nav
        class="ss-nav"
        aria-label="Main navigation"
      >
        <div class="ss-nav__inner">
          <ul class="ss-nav__list" role="list">
            {% for link in main_menu.links %}
              <li class="ss-nav__item{% if link.links != blank %} ss-nav__item--has-dropdown{% endif %}">

                <a
                  href="{{ link.url }}"
                  class="ss-nav__link{% if link.current %} is-active{% endif %}"
                >
                  <span>{{ link.title }}</span>

                  {% if link.links != blank %}
                    <svg
                      class="ss-nav__caret"
                      viewBox="0 0 10 6"
                      aria-hidden="true"
                    >
                      <path d="M1 1l4 4 4-4"></path>
                    </svg>
                  {% endif %}
                </a>


              {% if link.links != blank %}

  {% assign menu_title_key = link.title | handleize %}

  {% if menu_title_key == 'our-brands' %}

    <div class="ss-mega ss-mega--brands">
      <div class="ss-brands-grid">

        {% for block in section.blocks %}
          {% if block.type == 'brand' %}
            <a
              href="{{ block.settings.link | default: routes.root_url }}"
              class="ss-brand-card"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.logo != blank %}
                {{
                  block.settings.logo
                  | image_url: width: 320
                  | image_tag:
                    class: 'ss-brand-card__logo',
                    loading: 'lazy',
                    widths: '100, 140, 180, 240, 320',
                    alt: block.settings.name
                }}
              {% else %}
                <span class="ss-brand-card__name">
                  {{ block.settings.name }}
                </span>
              {% endif %}
            </a>
          {% endif %}
        {% endfor %}

        <a
          href="{{ section.settings.view_all_brands_link | default: routes.root_url }}"
          class="ss-brand-card ss-brand-card--view-all"
        >
          <span>
            VIEW<br>
            ALL<br>
            BRANDS
          </span>
        </a>

      </div>
    </div>

  {% else %}

    <div class="ss-mega">
      <div class="ss-mega__inner">

        {% for child_link in link.links %}
          <div class="ss-mega__group">

            <a
              href="{{ child_link.url }}"
              class="ss-mega__heading"
            >
              {{ child_link.title }}
            </a>

            {% if child_link.links != blank %}
              <ul class="ss-mega__links" role="list">
                {% for grandchild_link in child_link.links %}
                  <li>
                    <a href="{{ grandchild_link.url }}">
                      {{ grandchild_link.title }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}

          </div>
        {% endfor %}

      </div>
    </div>

  {% endif %}

{% endif %}

              </li>
            {% endfor %}
          </ul>
        </div>
      </nav>
    {% endif %}
  </div>


  {%- comment -%}
    ============================================================
    MOBILE HEADER
    ============================================================
  {%- endcomment -%}

  <div class="ss-mobile">
    <div class="ss-mobile__bar">

      <button
        type="button"
        class="ss-mobile__menu-button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="SSMobileDrawer-{{ section.id }}"
        data-ss-menu-open
      >
        <span></span>
        <span></span>
        <span></span>
      </button>


      <a
        href="{{ routes.root_url }}"
        class="ss-mobile__logo"
        aria-label="{{ shop.name | escape }}"
      >
        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: 400
            | image_tag:
              class: 'ss-mobile__logo-image',
              widths: '100, 140, 180, 220, 300, 400',
              loading: 'eager',
              alt: shop.name
          }}
        {% else %}
          {{ section.settings.logo_text }}
        {% endif %}
      </a>


      <div class="ss-mobile__actions">
        <button
          type="button"
          class="ss-mobile__search-button"
          aria-label="Open search"
          data-ss-search-toggle
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="M16 16L21 21"></path>
          </svg>
        </button>

        <a
          href="{{ routes.cart_url }}"
          class="ss-mobile__cart"
          aria-label="Cart, {{ cart.item_count }} items"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 8h10l1 12H6L7 8Z"></path>
            <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
          </svg>

          {% if cart.item_count > 0 %}
            <span class="ss-mobile__cart-bubble">
              {{ cart.item_count }}
            </span>
          {% endif %}
        </a>
      </div>

    </div>


    <div
      class="ss-mobile-search"
      hidden
      data-ss-mobile-search
    >
      <form
        action="{{ routes.search_url }}"
        method="get"
        role="search"
      >
        <input
          type="search"
          name="q"
          placeholder="{{ section.settings.search_placeholder | escape }}"
          aria-label="{{ section.settings.search_placeholder | escape }}"
        >

        <button type="submit" aria-label="Search">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="M16 16L21 21"></path>
          </svg>
        </button>
      </form>

      {% if section.settings.search_helper != blank %}
        <p>{{ section.settings.search_helper }}</p>
      {% endif %}
    </div>


    <div
      id="SSMobileDrawer-{{ section.id }}"
      class="ss-mobile-drawer"
      aria-hidden="true"
      data-ss-mobile-drawer
    >
      <button
        class="ss-mobile-drawer__overlay"
        type="button"
        aria-label="Close menu"
        data-ss-menu-close
      ></button>

      <div class="ss-mobile-drawer__panel">

        <div class="ss-mobile-drawer__header">
          <span>{{ section.settings.mobile_menu_title }}</span>

          <button
            type="button"
            aria-label="Close menu"
            data-ss-menu-close
          >
            ×
          </button>
        </div>


        {% if main_menu != blank %}
          <nav class="ss-mobile-nav">
            <ul role="list">
              {% for link in main_menu.links %}
                <li>

                  {% if link.links != blank %}
                    <details>
                      <summary>
                        <span>{{ link.title }}</span>

                        <svg viewBox="0 0 10 6" aria-hidden="true">
                          <path d="M1 1l4 4 4-4"></path>
                        </svg>
                      </summary>

                      <div class="ss-mobile-nav__submenu">

                        {% for child_link in link.links %}
                          {% if child_link.links != blank %}
                            <details>
                              <summary>
                                <span>{{ child_link.title }}</span>

                                <svg viewBox="0 0 10 6" aria-hidden="true">
                                  <path d="M1 1l4 4 4-4"></path>
                                </svg>
                              </summary>

                              <div class="ss-mobile-nav__grandchildren">
                                {% for grandchild_link in child_link.links %}
                                  <a href="{{ grandchild_link.url }}">
                                    {{ grandchild_link.title }}
                                  </a>
                                {% endfor %}
                              </div>
                            </details>
                          {% else %}
                            <a href="{{ child_link.url }}">
                              {{ child_link.title }}
                            </a>
                          {% endif %}
                        {% endfor %}

                      </div>
                    </details>
                  {% else %}
                    <a href="{{ link.url }}">
                      {{ link.title }}
                    </a>
                  {% endif %}

                </li>
              {% endfor %}
            </ul>
          </nav>
        {% endif %}


        <div class="ss-mobile-drawer__footer">
          {% if customer %}
            <a href="{{ routes.account_url }}">My Account</a>
          {% else %}
            <a href="{{ routes.account_login_url }}">Log In</a>
          {% endif %}

          {% if section.settings.show_wishlist %}
            <a href="{{ section.settings.wishlist_link | default: routes.root_url }}">
              Wishlist
            </a>
          {% endif %}
        </div>

      </div>
    </div>
  </div>
</header>


<style>
  /* ==========================================================
     RESET / ROOT
     ========================================================== */

  #{{ section_id }} {
    position: relative;
    z-index: 40;

    width: 100%;

    background: var(--ss-bg);
    color: var(--ss-text);

    font-family: Arial, Helvetica, sans-serif;
  }

  /* ==========================================================
   OUR BRANDS MEGA MENU
   ========================================================== */

#{{ section_id }} .ss-mega--brands {
  width: min(calc(100vw - 32px), 1270px);

  padding: 31px 35px 35px;

  background: #ffffff;

  border: 0;
}

#{{ section_id }} .ss-brands-grid {
  display: grid;

  grid-template-columns: repeat(8, minmax(0, 1fr));

  gap: 14px;
}

#{{ section_id }} .ss-brand-card {
  display: flex;
  align-items: center;
  justify-content: center;

  aspect-ratio: 1.12 / 1;

  min-width: 0;

  padding: 16px;

  border: 1px solid #d7dde0;
  border-radius: 5px;

  background: #ffffff;

  color: #777777;

  text-align: center;
  text-decoration: none;

  overflow: hidden;

  transition:
    border-color 150ms ease,
    box-shadow 150ms ease;
}

#{{ section_id }} .ss-brand-card:hover,
#{{ section_id }} .ss-brand-card:focus-visible {
  border-color: #aeb4b7;

  box-shadow: 0 0 0 3px #e1e3e4;

  outline: none;
}

#{{ section_id }} .ss-brand-card__logo {
  display: block;

  width: auto;
  max-width: 92%;
  height: auto;
  max-height: 74px;

  object-fit: contain;
}

#{{ section_id }} .ss-brand-card__name {
  font-size: 14px;
  font-weight: 600;
  line-height: 1.2;
}

#{{ section_id }} .ss-brand-card--view-all {
  font-size: 14px;
  font-weight: 400;
  line-height: 1.5;

  color: #7c7c7c;
}


/* Laptop */
@media screen and (max-width: 1199px) and (min-width: 900px) {

  #{{ section_id }} .ss-mega--brands {
    width: calc(100vw - 30px);

    padding: 26px 28px 30px;
  }

  #{{ section_id }} .ss-brands-grid {
    grid-template-columns: repeat(6, minmax(0, 1fr));

    gap: 12px;
  }

}


/* Tablet */
@media screen and (max-width: 899px) and (min-width: 750px) {

  #{{ section_id }} .ss-brands-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 12px;
  }

}


  #{{ section_id }} *,
  #{{ section_id }} *::before,
  #{{ section_id }} *::after {
    box-sizing: border-box;
  }

  #{{ section_id }} a {
    color: inherit;
  }

  #{{ section_id }} button,
  #{{ section_id }} input {
    font: inherit;
  }

  #{{ section_id }}.ss-header--sticky {
    position: sticky;
    top: 0;
  }


  /* ==========================================================
     DESKTOP TOP HEADER
     ========================================================== */

  #{{ section_id }} .ss-header__top {
    width: 100%;

    border-top: {{ section.settings.top_border_width }}px solid var(--ss-border);
    border-bottom: {{ section.settings.top_bottom_border_width }}px solid var(--ss-border);

    background: var(--ss-bg);
  }

  #{{ section_id }} .ss-header__top-inner {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto
      minmax(0, 1fr);

    align-items: center;

    width: calc(100% - (var(--ss-side-padding) * 2));
    max-width: var(--ss-max-width);

    min-height: var(--ss-top-height);

    margin-inline: auto;

    column-gap: clamp(30px, 5vw, 90px);
  }

  #{{ section_id }} .ss-header__search-wrap {
    display: flex;
    justify-content: flex-start;
    align-items: center;

    min-width: 0;
  }

  #{{ section_id }} .ss-header__logo-wrap {
    display: flex;
    justify-content: center;
    align-items: center;

    min-width: 0;
  }

  #{{ section_id }} .ss-header__actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;

    gap: {{ section.settings.action_gap }}px;

    min-width: 0;
  }


  /* ==========================================================
     SEARCH
     ========================================================== */

  #{{ section_id }} .ss-search {
    width: min(100%, var(--ss-search-width));

    margin: 0;
  }

  #{{ section_id }} .ss-search__field {
    position: relative;

    display: flex;
    align-items: center;

    height: 27px;

    border-bottom: 1px solid {{ section.settings.search_line_color }};

    transition: border-color 160ms ease;
  }

  #{{ section_id }} .ss-search__field:focus-within {
    border-bottom-color: {{ section.settings.search_focus_line_color }};
  }

  #{{ section_id }} .ss-search__input {
    width: 100%;
    height: 26px;

    margin: 0;
    padding: 0 29px 1px 0;

    border: 0;
    border-radius: 0;
    outline: 0;

    appearance: none;
    -webkit-appearance: none;

    background: transparent;
    box-shadow: none;

    color: var(--ss-text);

    font-size: {{ section.settings.search_font_size }}px;
    font-weight: 400;
    line-height: 26px;
  }

  #{{ section_id }} .ss-search__input::placeholder {
    color: {{ section.settings.search_placeholder_color }};
    opacity: 1;
  }

  #{{ section_id }} .ss-search__input::-webkit-search-cancel-button {
    display: none;
  }

  #{{ section_id }} .ss-search__submit {
    position: absolute;
    top: 50%;
    right: 1px;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 20px;
    height: 20px;

    padding: 0;

    transform: translateY(-50%);

    border: 0;

    background: transparent;

    color: {{ section.settings.search_icon_color }};

    cursor: pointer;
  }

  #{{ section_id }} .ss-search__submit svg {
    width: {{ section.settings.search_icon_size }}px;
    height: {{ section.settings.search_icon_size }}px;

    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  #{{ section_id }} .ss-search__helper {
    margin: 3px 0 0;
    padding: 0;

    color: var(--ss-muted);

    font-size: {{ section.settings.helper_font_size }}px;
    font-weight: 400;
    line-height: 1.3;

    white-space: nowrap;
  }


  /* ==========================================================
     LOGO
     ========================================================== */

  #{{ section_id }} .ss-logo {
    display: flex;
    align-items: center;
    justify-content: center;

    max-width: var(--ss-logo-width);

    text-decoration: none;
  }

  #{{ section_id }} .ss-logo__image {
    display: block;

    width: min(var(--ss-logo-width), 100%);
    height: auto;
    max-height: {{ section.settings.logo_max_height }}px;

    object-fit: contain;
  }

  #{{ section_id }} .ss-logo__placeholder {
    color: var(--ss-text);

    font-family: Georgia, 'Times New Roman', serif;
    font-size: 24px;
    font-weight: 700;
    white-space: nowrap;
  }


  /* ==========================================================
     ACTION BUTTONS
     ========================================================== */

  #{{ section_id }} .ss-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 5px;

    height: {{ section.settings.action_height }}px;

    padding: 0 {{ section.settings.action_horizontal_padding }}px;

    border: 1px solid var(--ss-border);
    border-radius: {{ section.settings.action_radius }}px;

    background: var(--ss-bg);

    color: var(--ss-muted);

    font-size: {{ section.settings.action_font_size }}px;
    font-weight: 400;
    line-height: 1;

    text-decoration: none;
    white-space: nowrap;

    cursor: pointer;

    transition:
      color 150ms ease,
      border-color 150ms ease,
      box-shadow 150ms ease;
  }

  #{{ section_id }} .ss-action:hover,
  #{{ section_id }} .ss-action:focus-visible {
    color: var(--ss-hover);

    border-color: {{ section.settings.hover_border_color }};

    box-shadow: 0 0 0 {{ section.settings.hover_ring_size }}px var(--ss-focus-ring);

    outline: none;
  }

  #{{ section_id }} .ss-action__heart {
    width: {{ section.settings.heart_size }}px;
    height: {{ section.settings.heart_size }}px;

