              <div class="salon-pagination">
                {{ paginate | default_pagination }}
              </div>
            {% endif %}

          {% endpaginate %}

        </main>

      </div>

    </results-list>
  </collection-component>

</div>

{% stylesheet %}

/* ==========================================
   SALON SUPPORT COLLECTION
========================================== */

.salon-collection {
  width: min(1380px, calc(100% - 40px));
  margin: 0 auto;
  padding: 22px 0 70px;
}

/* Breadcrumb */

.salon-collection__breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 28px;
  font-size: 13px;
  color: #555;
}

.salon-collection__breadcrumb a {
  color: inherit;
  text-decoration: none;
}

.salon-collection__breadcrumb a:hover {
  text-decoration: underline;
}

/* Header */

.salon-collection__header {
  margin: 0;
}



.salon-subcategories {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  column-gap: 35px;
  row-gap: 8px;
  padding: 16px 0 17px;
  border-top: 1px solid #dedede;
  border-bottom: 1px solid #dedede;
}

.salon-subcategories a {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #111;
  text-decoration: none;
  font-size: 14px;
  line-height: 1.25;
  font-weight: 700;
}

.salon-subcategories a span {
  font-size: 26px;
  line-height: 14px;
  font-weight: 400;
}

.salon-subcategories a:hover {
  text-decoration: underline;
}

.salon-collection__header h1 {
  margin: 0 0 18px;
  font-size: 32px;
  line-height: 1.15;
  font-weight: 700;
}

.salon-collection__description {
  max-width: 950px;
  font-size: 14px;
  line-height: 1.7;
}

.salon-collection__description > :first-child {
  margin-top: 0;
}

.salon-collection__description > :last-child {
  margin-bottom: 0;
}

/* Layout */

.salon-collection__layout {
  display: grid;
  grid-template-columns: 280px minmax(0, 1fr);
  gap: 30px;
  align-items: start;
}

/* ==========================================
   SIDEBAR
========================================== */

.salon-collection__sidebar {
  min-width: 0;
}

.salon-sidebar-box {
  border: 1px solid #d8d8d8;
  border-radius: 8px;
  overflow: hidden;
  background: #fff;
  margin-bottom: 20px;
}

.salon-sidebar-title {
  margin: 0;
  padding: 16px 18px;
  font-size: 17px;
  line-height: 1.2;
  font-weight: 700;
  border-bottom: 1px solid #dedede;
}

.salon-sidebar-links {
  display: flex;
  flex-direction: column;
  padding: 8px 18px 13px;
}

.salon-sidebar-links a {
  display: block;
  padding: 7px 0;
  color: #222;
  font-size: 14px;
  line-height: 1.4;
  text-decoration: none;
}

.salon-sidebar-links a:hover {
  text-decoration: underline;
}

/* ==========================================
   HORIZON FACETS OVERRIDES
========================================== */

.salon-collection .facets-block-wrapper--vertical {
  margin: 0 !important;
  width: 100%;
  grid-column: auto !important;
}

.salon-collection .facets--vertical {
  width: 100%;
  padding: 0 !important;
}

.salon-collection .facets__form-wrapper,
.salon-collection .facets__form {
  width: 100%;
}

.salon-collection .facets__filters-wrapper {
  margin: 0 !important;
}

.salon-collection .facets--filters-title,
.salon-collection .products-count-wrapper {
  display: none !important;
}

.salon-collection .facets--vertical .facets__item {
  padding-left: 18px;
  padding-right: 18px;
}

.salon-collection .facets--vertical .facets__summary {
  font-size: 14px;
  font-weight: 700;
  padding-top: 14px;
  padding-bottom: 14px;
}

.salon-collection
  .facets--vertical
  .facets__item:not(:first-of-type)::before {
  border-color: #e2e2e2;
}

.salon-collection .facets__label {
  font-size: 13px;
}

.salon-collection .filter-remove-buttons {
  padding-left: 18px;
  padding-right: 18px;
}

/* ==========================================
   PRODUCT AREA
========================================== */

.salon-collection__main {
  min-width: 0;
}

.salon-product-count {
  width: 100%;
  text-align: center;
  border-top: 1px solid #ddd;
  border-bottom: 1px solid #ddd;
  padding: 16px 10px;
  margin-bottom: 25px;
  font-size: 15px;
  font-weight: 600;
}

.salon-product-grid {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px 16px;
}

.salon-product-grid__item {
  min-width: 0;
  margin: 0;
}

.salon-product-grid__item > * {
  width: 100%;
}

.salon-pagination {
  margin-top: 40px;
  display: flex;
  justify-content: center;
}

.salon-no-products {
  grid-column: 1 / -1;
  text-align: center;
  padding: 50px 20px;
}

/* ==========================================
   TABLET
========================================== */

@media screen and (max-width: 1100px) {

  .salon-collection__layout {
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 22px;
  }

 

  .salon-product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* ==========================================
   MOBILE
========================================== */

@media screen and (max-width: 749px) {

  .salon-collection {
    width: calc(100% - 30px);
    padding-top: 16px;
    padding-bottom: 45px;
  }

  .salon-collection__breadcrumb {
    margin-bottom: 20px;
  }

  .salon-collection__header {
    margin-left: 0;
    margin-bottom: 22px;
  }

  .salon-collection__header h1 {
    font-size: 26px;
  }

  .salon-collection__layout {
    display: block;
  }

  .salon-sidebar-box:not(.salon-sidebar-box--filters) {
    display: none;
  }

  .salon-sidebar-box--filters {
    border: 0;
    overflow: visible;
    margin-bottom: 18px;
  }

  .salon-sidebar-box--filters > .salon-sidebar-title {
    display: none;
  }

  .salon-product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 10px;
  }

  .salon-product-count {
    margin-bottom: 20px;
  }
}

@media screen and (max-width: 480px) {

  .salon-product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
/* ==========================================
   REFERENCE SIDEBAR MATCH
========================================== */

@media screen and (min-width: 750px) {

  /* BOXES */

  .salon-collection .salon-sidebar-box {
    border: 1px solid #d4d4d4;
    border-radius: 10px 10px 26px 26px;
    overflow: hidden;
    background: #fff;
    margin-bottom: 28px;
  }

  .salon-collection .salon-sidebar-title {
    margin: 0;
    padding: 16px 20px;
    font-size: 17px;
    line-height: 1.2;
    font-weight: 700;
  }

  /* Categories / Information don't have
     heading divider on reference */

  .salon-collection
  .salon-sidebar-box:not(.salon-sidebar-box--filters)
  .salon-sidebar-title {
    border-bottom: 0;
    padding-bottom: 8px;
  }

  .salon-collection
  .salon-sidebar-box:not(.salon-sidebar-box--filters)
  .salon-sidebar-links {
    padding: 0 20px 18px;
  }

  .salon-collection
  .salon-sidebar-box:not(.salon-sidebar-box--filters)
  .salon-sidebar-links a {
    padding: 4px 0;
    font-size: 14px;
    line-height: 1.45;
  }


  /* ==========================================
     FILTER GROUPS
  ========================================== */

  .salon-collection
  .facets--vertical
  .facets__item {
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  .salon-collection
  .facets--vertical
  .facets__item::before {
    width: 100% !important;
    border-color: #dddddd !important;
  }

  .salon-collection
  .facets--vertical
  .facets__summary {
    padding: 14px 20px 8px !important;
    min-height: auto !important;
    font-size: 15px !important;
    line-height: 1.3 !important;
    font-weight: 400 !important;
    pointer-events: none;
  }

  /* Remove Horizon accordion arrows */

  .salon-collection
  .facets__summary
  .icon-caret {
    display: none !important;
  }

  .salon-collection
  .facets__panel-content {
    padding: 0 20px 16px !important;
  }

  .salon-collection
  .facets__inputs-wrapper {
    margin: 0 !important;
    gap: 5px !important;
  }


  /* ==========================================
     FILTER OPTIONS + COUNTS
  ========================================== */

  .salon-collection .salon-filter-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    width: 100%;
  }

  .salon-collection .salon-filter-option__checkbox {
    flex: 1 1 auto;
    min-width: 0;
  }

  .salon-collection
  .salon-filter-option__checkbox
  .checkbox {
    width: 100%;
  }

  .salon-collection .salon-filter-count {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;

    min-width: 20px;
    height: 20px;
    padding: 0 5px;

    border-radius: 20px;
    background: #eeeeee;

    color: #333;
    font-size: 11px;
    line-height: 1;
    font-weight: 600;

    flex: 0 0 auto;
  }

  .salon-collection .checkbox__label-text {
    color: #222 !important;
    font-size: 14px !important;
    line-height: 1.35;
  }

  .salon-collection
  .checkbox--disabled
  .checkbox__label-text {
    color: #999 !important;
  }


  /* ==========================================
     CUSTOM PRICE FILTER
  ========================================== */

  /* Keep Shopify's native inputs in DOM
     for filtering but hide visually */

  .salon-collection .price-facet__native-ui {
    display: none !important;
  }

  .salon-collection .salon-price-filter {
    display: block;
    width: 100%;
    padding-top: 4px;
  }

  .salon-collection .salon-price-slider {
    position: relative;
    width: calc(100% - 8px);
    height: 22px;
    margin: 2px 4px 11px;
  }

  .salon-collection .salon-price-slider::before {
    content: '';
    position: absolute;

    left: 0;
    right: 0;
    top: 8px;

    height: 8px;

    background: #aeb7bf;
  }

  .salon-collection .salon-price-range {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 22px;

    margin: 0;

    background: transparent;

    -webkit-appearance: none;
    appearance: none;

    pointer-events: none;
  }

  .salon-collection
  .salon-price-range::-webkit-slider-runnable-track {
    height: 8px;
    background: transparent;
    border: 0;
  }

  .salon-collection
  .salon-price-range::-webkit-slider-thumb {
    width: 16px;
    height: 16px;

    margin-top: -4px;

    border: 1px solid #bfc3c6;
    border-radius: 2px;

    background: #f5f5f5;

    -webkit-appearance: none;
    appearance: none;

    pointer-events: auto;
    cursor: pointer;
  }

  .salon-collection
  .salon-price-range::-moz-range-track {
    height: 8px;
    background: transparent;
    border: 0;
  }

  .salon-collection
  .salon-price-range::-moz-range-thumb {
    width: 16px;
    height: 16px;

    border: 1px solid #bfc3c6;
    border-radius: 2px;

    background: #f5f5f5;

    pointer-events: auto;
    cursor: pointer;
  }

  .salon-collection .salon-price-range--min {
    z-index: 2;
  }

  .salon-collection .salon-price-range--max {
    z-index: 3;
  }

  .salon-collection .salon-price-values {
    display: flex;
    align-items: center;
    gap: 5px;

    margin: 0 8px 13px;

    color: #222;
    font-size: 14px;
    line-height: 1.4;
  }

  .salon-collection .salon-price-filter-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 36px;

    padding: 7px 15px;

    border: 1px solid #c9cdd0;
    border-radius: 20px;

    background: #fff;
    color: #222;

    font: inherit;
    font-size: 14px;

    cursor: pointer;
  }

  .salon-collection .salon-price-filter-button:hover {
    border-color: #999;
  }

}

{% endstylesheet %}

{% schema %}
{
  "name": "Salon Collection",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 6,
      "max": 36,
      "step": 3,
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Salon Collection",
      "settings": {
        "products_per_page": 24
      },
      "blocks": {
        "filters": {
          "type": "filters",
          "static": true,
          "settings": {
            "enable_filtering": true,
            "filter_style": "vertical",
            "filter_width": "centered",
            "text_label_case": "default",
            "show_swatch_label": false,
            "show_filter_label": false,
            "enable_sorting": false,
            "enable_grid_density": false,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0,
            "facets_margin_right": 0
          }
        },

        "static-product-card": {
          "type": "_product-card",
          "name": "Product card",
          "static": true,
          "settings": {
            "product_card_gap": 4,
            "display_collection": "",
            "background_color": "",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_color": "",
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {

            "product_card_gallery_W8dmic": {
              "type": "_product-card-gallery",
              "name": "Product media",
              "settings": {
                "image_ratio": "square",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_color": "",
                "border_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },

            "custom_liquid_ikGhh3": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "{% liquid\n  assign product = closest.product\n%}\n\n{% if product.collections.size > 0 %}\n  <div class=\"product-card__collection\">\n    {{ product.collections.first.title }}\n  </div>\n{% endif %}"
              },
              "blocks": {}
            },

            "product_title_eRDkGY": {
