{%- comment -%}
  ============================================================
  SALON SUPPORT - FEATURED CATEGORIES
  Self-contained Shopify Online Store 2.0 section
  ============================================================

  Features:
  - Desktop: 3 columns x 2 rows
  - Tablet: 2 columns
  - Mobile: 1 column
  - Editable section background image / color
  - Editable heading
  - Editable category image, title, link, image position
  - Fully scoped CSS
  - No external libraries
  - No JavaScript required
{%- endcomment -%}

{%- liquid
  assign section_uid = 'SalonFeaturedCategories-' | append: section.id
-%}

<section
  id="{{ section_uid }}"
  class="sfc-section"
  style="
    --sfc-bg-color: {{ section.settings.background_color }};
    --sfc-heading-color: {{ section.settings.heading_color }};
    --sfc-card-text-color: {{ section.settings.card_text_color }};

    --sfc-content-width: {{ section.settings.content_max_width }}px;

    --sfc-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --sfc-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --sfc-padding-side-desktop: {{ section.settings.padding_side_desktop }}px;

    --sfc-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --sfc-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --sfc-padding-side-mobile: {{ section.settings.padding_side_mobile }}px;

    --sfc-heading-size: {{ section.settings.heading_font_size }}px;
    --sfc-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
    --sfc-heading-letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    --sfc-heading-bottom-gap: {{ section.settings.heading_bottom_gap }}px;

    --sfc-column-gap: {{ section.settings.column_gap }}px;
    --sfc-row-gap: {{ section.settings.row_gap }}px;

    --sfc-card-height: {{ section.settings.card_height }}px;
    --sfc-card-height-tablet: {{ section.settings.card_height_tablet }}px;
    --sfc-card-height-mobile: {{ section.settings.card_height_mobile }}px;

    --sfc-card-radius: {{ section.settings.card_radius }}px;

    --sfc-title-size: {{ section.settings.card_title_font_size }}px;
    --sfc-title-size-tablet: {{ section.settings.card_title_font_size_tablet }}px;
    --sfc-title-size-mobile: {{ section.settings.card_title_font_size_mobile }}px;

    --sfc-title-left: {{ section.settings.card_title_left }}px;
    --sfc-title-bottom: {{ section.settings.card_title_bottom }}px;

    --sfc-title-shadow-x: {{ section.settings.shadow_x }}px;
    --sfc-title-shadow-y: {{ section.settings.shadow_y }}px;
    --sfc-title-shadow-blur: {{ section.settings.shadow_blur }}px;
    --sfc-title-shadow-color: {{ section.settings.shadow_color }};
  "
>
  <div class="sfc-background">
    {% if section.settings.background_image != blank %}
      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          class: 'sfc-background__image',
          loading: 'lazy',
          widths: '750, 1000, 1400, 1800, 2200, 2400',
          alt: ''
      }}
    {% endif %}
  </div>

  <div class="sfc-container">

    {% if section.settings.heading != blank %}
      <div class="sfc-heading-wrap">
        <h2 class="sfc-heading">
          {{ section.settings.heading }}
        </h2>
      </div>
    {% endif %}

    <div class="sfc-grid">

      {% for block in section.blocks %}
        {% if block.type == 'category' %}

          {% liquid
            assign card_link = block.settings.link
            assign image_position = block.settings.image_position
          %}

          <a
            class="sfc-card"
            href="{{ card_link | default: '#' }}"
            {{ block.shopify_attributes }}
          >

            <div
  class="sfc-card__media"
  style="--sfc-image-position: {{ image_position }};"
>

              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'sfc-card__image',
                    loading: 'lazy',
                    widths: '360, 540, 720, 900, 1200',
                    sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                    alt: block.settings.title
                }}
              {% else %}
                <div class="sfc-card__placeholder">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}

            </div>

            {% if block.settings.title != blank %}
              <div class="sfc-card__content">
                <span class="sfc-card__title">
                  {{ block.settings.title }}
                </span>
              </div>
            {% endif %}

    
          </a>

        {% endif %}
      {% endfor %}

    </div>

  </div>
</section>

<style>
  /* =========================================================
     SECTION ROOT
     ========================================================= */

  #{{ section_uid }} {
    position: relative;

    width: 100%;

    overflow: hidden;

    background: var(--sfc-bg-color);
  }

  #{{ section_uid }} *,
  #{{ section_uid }} *::before,
  #{{ section_uid }} *::after {
    box-sizing: border-box;
  }


  /* =========================================================
     BACKGROUND
     ========================================================= */

  #{{ section_uid }} .sfc-background {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    z-index: 0;

    pointer-events: none;
  }

  #{{ section_uid }} .sfc-background__image {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: var(--sfc-image-position, center);

    opacity: 1;
  }


  /* =========================================================
     CONTAINER
     ========================================================= */

  #{{ section_uid }} .sfc-container {
    position: relative;

    z-index: 1;

    width: min(
      calc(100% - (var(--sfc-padding-side-desktop) * 2)),
      var(--sfc-content-width)
    );

    margin-inline: auto;

    padding-top: var(--sfc-padding-top-desktop);
    padding-bottom: var(--sfc-padding-bottom-desktop);
  }


  /* =========================================================
     HEADING
     ========================================================= */

  #{{ section_uid }} .sfc-heading-wrap {
    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: var(--sfc-heading-bottom-gap);

    text-align: center;
  }



  #{{ section_uid }} .sfc-heading {
    margin: 0;
    padding: 0;

    color: var(--sfc-heading-color);

    font-family: var(--font-h2--family);
    font-size: var(--font-h2--size);
    font-weight: 700;
    line-height: 1.15;

    letter-spacing: var(--sfc-heading-letter-spacing);

    text-align: center;
    text-transform: uppercase;
  }


  /* =========================================================
     GRID
     ========================================================= */

  #{{ section_uid }} .sfc-grid {
    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));

    column-gap: var(--sfc-column-gap);
    row-gap: var(--sfc-row-gap);
  }


  /* =========================================================
     CARD
     ========================================================= */

  #{{ section_uid }} .sfc-card {
    position: relative;

    display: block;

    width: 100%;
    height: var(--sfc-card-height);

    overflow: hidden;

    border-radius: 15px;
    border-bottom-right-radius: 60px;
    

    color: inherit;

    text-decoration: none;

    background: #f5f5f5;

    isolation: isolate;
  }

  #{{ section_uid }} .sfc-card:focus-visible {
    outline: 2px solid #111111;
    outline-offset: 3px;
  }


  /* =========================================================
     IMAGE
     ========================================================= */

  #{{ section_uid }} .sfc-card__media {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;
  }

  #{{ section_uid }} .sfc-card__image {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: var(--sfc-image-position, center);

    transition: transform 260ms ease;
  }

   #{{ section_uid }} .sfc-card:hover{
    border-bottom-right-radius: 15px !important;
    }
  #{{ section_uid }} .sfc-card:hover .sfc-card__image {
    transform: scale(1.025);
    
  }

  #{{ section_uid }} .sfc-card__placeholder {
    width: 100%;
    height: 100%;

    background: #eeeeee;
  }

  #{{ section_uid }} .sfc-card__placeholder svg {
    width: 100%;
    height: 100%;
  }


  /* =========================================================
     TITLE
     ========================================================= */

  #{{ section_uid }} .sfc-card__content {
    position: absolute;

    left: var(--sfc-title-left);
    right: 18px;
    bottom: var(--sfc-title-bottom);

    z-index: 2;
  }

  #{{ section_uid }} .sfc-card__title {
    display: inline;

    color: var(--sfc-card-text-color);

    font-family: var(--font-h2--family);
    font-size: var(--font-h2--size);
    font-weight: 700;
    line-height: 1.15;

    text-transform: uppercase;

    text-shadow:
      var(--sfc-title-shadow-x)
      var(--sfc-title-shadow-y)
      var(--sfc-title-shadow-blur)
      var(--sfc-title-shadow-color);
  }


  /* =========================================================
     TABLET
     ========================================================= */

  @media screen and (max-width: 989px) and (min-width: 750px) {

    #{{ section_uid }} .sfc-container {
      width: min(
        calc(100% - 40px),
        var(--sfc-content-width)
      );
    }

    #{{ section_uid }} .sfc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ section_uid }} .sfc-card {
      height: var(--sfc-card-height-tablet);
    }

    #{{ section_uid }} .sfc-card__title {
      font-size: var(--sfc-title-size-tablet);
    }
  }


  /* =========================================================
     MOBILE
     ========================================================= */

  @media screen and (max-width: 749px) {

    #{{ section_uid }} .sfc-container {
      width: calc(
        100% - (var(--sfc-padding-side-mobile) * 2)
      );

      padding-top: var(--sfc-padding-top-mobile);
      padding-bottom: var(--sfc-padding-bottom-mobile);
    }

    #{{ section_uid }} .sfc-heading-wrap {
      margin-bottom: clamp(
        22px,
        6vw,
        var(--sfc-heading-bottom-gap)
      );
    }

    #{{ section_uid }} .sfc-heading {
      font-size: var(--sfc-heading-size-mobile);
    }

    #{{ section_uid }} .sfc-grid {
      grid-template-columns: 1fr;

      column-gap: 0;
      row-gap: clamp(14px, 4vw, var(--sfc-row-gap));
    }

    #{{ section_uid }} .sfc-card {
      height: var(--sfc-card-height-mobile);
    }

    #{{ section_uid }} .sfc-card__content {
      left: clamp(16px, 5vw, var(--sfc-title-left));
      right: 16px;
      bottom: clamp(15px, 4vw, var(--sfc-title-bottom));
    }

    #{{ section_uid }} .sfc-card__title {
      font-size: var(--sfc-title-size-mobile);
    }
  }


  /* =========================================================
     REDUCED MOTION
     ========================================================= */

  @media (prefers-reduced-motion: reduce) {
    #{{ section_uid }} .sfc-card__image {
      transition: none;
    }

    #{{ section_uid }} .sfc-card:hover .sfc-card__image {
      transform: none;
    }
  }
</style>

{% schema %}
{
  "name": "Salon Featured Categories",
  "tag": "section",
  "class": "salon-featured-categories-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FEATURED CATEGORIES"
    },

    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fallback background color",
      "default": "#F3E4F2"
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 900,
      "max": 1500,
      "step": 10,
      "unit": "px",
      "default": 1210
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 8,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row gap",
      "min": 8,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 28
    },

    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop padding top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop padding bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "padding_side_desktop",
      "label": "Desktop side padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile padding top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_side_mobile",
      "label": "Mobile side padding",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },

    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#202A35"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Desktop heading size",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 21
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Mobile heading size",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading letter spacing",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "heading_bottom_gap",
      "label": "Gap below heading",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 38
    },

    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Desktop card height",
      "min": 180,
      "max": 420,
      "step": 5,
      "unit": "px",
      "default": 265
    },
    {
      "type": "range",
      "id": "card_height_tablet",
      "label": "Tablet card height",
      "min": 180,
      "max": 360,
      "step": 5,
      "unit": "px",
      "default": 245
    },
    {
      "type": "range",
      "id": "card_height_mobile",
      "label": "Mobile card height",
      "min": 170,
      "max": 340,
      "step": 5,
      "unit": "px",
      "default": 220
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },

    {
      "type": "header",
      "content": "Card titles"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card title color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "card_title_font_size",
      "label": "Desktop title size",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 31
    },
    {
      "type": "range",
      "id": "card_title_font_size_tablet",
      "label": "Tablet title size",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 27
    },
    {
      "type": "range",
      "id": "card_title_font_size_mobile",
      "label": "Mobile title size",
      "min": 16,
      "max": 34,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_title_left",
      "label": "Title left spacing",
      "min": 8,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_title_bottom",
      "label": "Title bottom spacing",
      "min": 8,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },

    {
      "type": "header",
      "content": "Title shadow"
    },
    {
      "type": "range",
      "id": "shadow_x",
      "label": "Shadow horizontal",
      "min": -10,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "shadow_y",
      "label": "Shadow vertical",
      "min": -10,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "range",
      "id": "shadow_blur",
      "label": "Shadow blur",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 5
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Shadow color",
      "default": "#000000"
    }
  ],

  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category title",
          "default": "CATEGORY"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category link"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "options": [
            {
              "value": "center center",
              "label": "Center"
            },
            {
              "value": "center top",
              "label": "Top"
            },
            {
              "value": "center bottom",
              "label": "Bottom"
            },
            {
              "value": "left center",
              "label": "Left"
            },
            {
              "value": "right center",
              "label": "Right"
            }
          ],
          "default": "center center"
        }
      ]
    }
  ],

  "max_blocks": 6,

  "presets": [
    {
      "name": "Salon Featured Categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "BRAZILIAN BOND BUILDER"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "OLIGO PRO BLACKLIGHT"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "HAIR COLOUR"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "HAIR CARE"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "DEVELOPERS"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "LIGHTENERS"
          }
        }
      ]
    }
  ]
}
{% endschema %}