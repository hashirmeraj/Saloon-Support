{%- comment -%}
  ============================================================
  SALON SUPPORT - GLOBAL FOOTER
  ============================================================

  Features:
  - 3 navigation menu columns
  - Newsletter signup
  - Terms/privacy agreement checkbox
  - Email / Facebook / Instagram links
  - Copyright + ABN
  - Payment methods image
  - Desktop / tablet / mobile responsive
  - Self-contained CSS
  - No snippets required
  - No external libraries
  ============================================================
{%- endcomment -%}

{%- assign footer_uid = 'SalonSupportFooter-' | append: section.id -%}

<footer
  id="{{ footer_uid }}"
  class="ssf"
  style="
    --ssf-bg: {{ section.settings.background_color }};
    --ssf-bottom-bg: {{ section.settings.bottom_background_color }};
    --ssf-heading-color: {{ section.settings.heading_color }};
    --ssf-link-color: {{ section.settings.link_color }};
    --ssf-link-hover: {{ section.settings.link_hover_color }};
    --ssf-text-color: {{ section.settings.text_color }};
    --ssf-divider: {{ section.settings.divider_color }};
    --ssf-input-border: {{ section.settings.input_border_color }};
    --ssf-max-width: {{ section.settings.content_max_width }}px;
    --ssf-top-padding: {{ section.settings.desktop_padding_top }}px;
    --ssf-bottom-padding: {{ section.settings.desktop_padding_bottom }}px;
    --ssf-side-padding: {{ section.settings.desktop_side_padding }}px;
    --ssf-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --ssf-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --ssf-mobile-side-padding: {{ section.settings.mobile_side_padding }}px;
    --ssf-heading-size: {{ section.settings.heading_font_size }}px;
    --ssf-link-size: {{ section.settings.link_font_size }}px;
    --ssf-newsletter-width: {{ section.settings.newsletter_width }}px;
    --ssf-bottom-padding-y: {{ section.settings.bottom_strip_padding }}px;
    --ssf-shadow-opacity: {{ section.settings.shadow_opacity | divided_by: 100.0 }};
  "
>

  <div class="ssf__main">
    <div class="ssf__container">

      <div class="ssf__grid">

        {%- comment -%}
          SERVICE
        {%- endcomment -%}
        <div class="ssf__column">
          <h3 class="ssf__heading">
            {{ section.settings.service_heading }}
          </h3>

          {% if section.settings.service_menu != blank %}
            <ul class="ssf__links" role="list">
              {% for link in section.settings.service_menu.links %}
                <li>
                  <a href="{{ link.url }}">
                    {{ link.title }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>


        {%- comment -%}
          ABOUT US
        {%- endcomment -%}
        <div class="ssf__column">
          <h3 class="ssf__heading">
            {{ section.settings.about_heading }}
          </h3>

          {% if section.settings.about_menu != blank %}
            <ul class="ssf__links" role="list">
              {% for link in section.settings.about_menu.links %}
                <li>
                  <a href="{{ link.url }}">
                    {{ link.title }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>


        {%- comment -%}
          INFORMATION
        {%- endcomment -%}
        <div class="ssf__column">
          <h3 class="ssf__heading">
            {{ section.settings.information_heading }}
          </h3>

          {% if section.settings.information_menu != blank %}
            <ul class="ssf__links" role="list">
              {% for link in section.settings.information_menu.links %}
                <li>
                  <a href="{{ link.url }}">
                    {{ link.title }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>


        {%- comment -%}
          STAY IN TOUCH
        {%- endcomment -%}
        <div class="ssf__newsletter-column">

          <h3 class="ssf__heading">
            {{ section.settings.newsletter_heading }}
          </h3>

          {% form 'customer', class: 'ssf__newsletter-form' %}

            <input
              type="hidden"
              name="contact[tags]"
              value="newsletter"
            >

            <div class="ssf__newsletter-field">

              <label
                class="visually-hidden"
                for="SSFEmail-{{ section.id }}"
              >
                Email
              </label>

              <input
                id="SSFEmail-{{ section.id }}"
                class="ssf__email-input"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ section.settings.email_placeholder }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                required
              >

              <button
                class="ssf__subscribe"
                type="submit"
              >
                {{ section.settings.subscribe_label }}
              </button>

            </div>

            {% if form.posted_successfully? %}
              <p class="ssf__form-message ssf__form-message--success">
                {{ section.settings.success_message }}
              </p>
            {% endif %}

            {% if form.errors %}
              <div class="ssf__form-message ssf__form-message--error">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

          {% endform %}


          {% if section.settings.show_agreement %}
            <label class="ssf__agreement">

              <input
                type="checkbox"
                class="ssf__agreement-checkbox"
              >

              <span class="ssf__agreement-text">
                {{ section.settings.agreement_prefix }}

                {% if section.settings.terms_link != blank %}
                  <a href="{{ section.settings.terms_link }}">
                    {{ section.settings.terms_label }}
                  </a>
                {% else %}
                  {{ section.settings.terms_label }}
                {% endif %}

                {{ section.settings.agreement_middle }}

                {% if section.settings.privacy_link != blank %}
                  <a href="{{ section.settings.privacy_link }}">
                    {{ section.settings.privacy_label }}
                  </a>
                {% else %}
                  {{ section.settings.privacy_label }}
                {% endif %}.
              </span>

            </label>
          {% endif %}


          <div class="ssf__socials">

            {% if section.settings.email_link != blank %}
              <a
                href="mailto:{{ section.settings.email_link }}"
                class="ssf__social"
                aria-label="Email"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M3 5h18v14H3V5Zm1.8 1.5L12 12l7.2-5.5H4.8ZM4.5 17.5h15V8.1L12 13.8 4.5 8.1v9.4Z"/>
                </svg>
              </a>
            {% endif %}


            {% if section.settings.facebook_url != blank %}
              <a
                href="{{ section.settings.facebook_url }}"
                class="ssf__social"
                target="_blank"
                rel="noopener"
                aria-label="Facebook"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M13.6 22v-8.2h2.8l.4-3.2h-3.2v-2c0-.9.3-1.6 1.7-1.6H17V4.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.4H7.5v3.2h2.8V22h3.3Z"/>
                </svg>
              </a>
            {% endif %}


            {% if section.settings.instagram_url != blank %}
              <a
                href="{{ section.settings.instagram_url }}"
                class="ssf__social"
                target="_blank"
                rel="noopener"
                aria-label="Instagram"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M7.2 2h9.6A5.2 5.2 0 0 1 22 7.2v9.6a5.2 5.2 0 0 1-5.2 5.2H7.2A5.2 5.2 0 0 1 2 16.8V7.2A5.2 5.2 0 0 1 7.2 2Zm0 1.8a3.4 3.4 0 0 0-3.4 3.4v9.6a3.4 3.4 0 0 0 3.4 3.4h9.6a3.4 3.4 0 0 0 3.4-3.4V7.2a3.4 3.4 0 0 0-3.4-3.4H7.2Zm10.1 1.4a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4ZM12 6.9A5.1 5.1 0 1 1 12 17a5.1 5.1 0 0 1 0-10.1Zm0 1.8a3.3 3.3 0 1 0 0 6.6 3.3 3.3 0 0 0 0-6.6Z"/>
                </svg>
              </a>
            {% endif %}

          </div>

        </div>

      </div>

    </div>
  </div>


  {%- comment -%}
    BOTTOM STRIP
  {%- endcomment -%}

  <div class="ssf__bottom">

    <div class="ssf__bottom-container">

      <div class="ssf__legal">
        <div class="ssf__copyright">
          {{ section.settings.copyright_text }}
        </div>

        {% if section.settings.abn_text != blank %}
          <div class="ssf__abn">
            {{ section.settings.abn_text }}
          </div>
        {% endif %}
      </div>


      {% if section.settings.payment_image != blank %}
        <div class="ssf__payments">
          {{
            section.settings.payment_image
            | image_url: width: 1200
            | image_tag:
              class: 'ssf__payment-image',
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200',
              alt: 'Payment methods'
          }}
        </div>
      {% endif %}

    </div>

  </div>

</footer>


<style>

  /* =========================================================
     ROOT
     ========================================================= */

  #{{ footer_uid }} {
    width: 100%;

    color: var(--ssf-text-color);

    font-family: Arial, Helvetica, sans-serif;
  }

  #{{ footer_uid }} *,
  #{{ footer_uid }} *::before,
  #{{ footer_uid }} *::after {
    box-sizing: border-box;
  }


  /* =========================================================
     MAIN WHITE AREA + TOP SHADOW
     ========================================================= */

  #{{ footer_uid }} .ssf__main {
    position: relative;

    background: var(--ssf-bg);

    box-shadow:
      0 -3px 10px
      rgba(0, 0, 0, var(--ssf-shadow-opacity));
  }

  #{{ footer_uid }} .ssf__container {
    width: min(
      calc(100% - (var(--ssf-side-padding) * 2)),
      var(--ssf-max-width)
    );

    margin-inline: auto;

    padding-top: var(--ssf-top-padding);
    padding-bottom: var(--ssf-bottom-padding);
  }


  /* =========================================================
     DESKTOP GRID
     ========================================================= */

  #{{ footer_uid }} .ssf__grid {
    display: grid;

    grid-template-columns:
      1fr
      1fr
      1fr
      minmax(290px, 1.55fr);

    column-gap: clamp(40px, 5vw, 92px);

    align-items: start;
  }


  /* =========================================================
     HEADINGS
     ========================================================= */

  #{{ footer_uid }} .ssf__heading {
    position: relative;

    margin: 0 0 14px;

    padding-bottom: 5px;

    color: var(--ssf-heading-color);

    font-size: var(--ssf-heading-size);
    font-weight: 700;
    line-height: 1.2;

    border-bottom: 1px solid var(--ssf-divider);
  }


  /* =========================================================
     MENU LINKS
     ========================================================= */

  #{{ footer_uid }} .ssf__links {
    margin: 0;
    padding: 0;

    list-style: none;
  }

  #{{ footer_uid }} .ssf__links li + li {
    margin-top: 13px;
  }

  #{{ footer_uid }} .ssf__links a {
    color: var(--ssf-link-color);

    font-size: var(--ssf-link-size);
    font-weight: 400;
    line-height: 1.35;

    text-decoration: none;

    transition: color 160ms ease;
  }

  #{{ footer_uid }} .ssf__links a:hover {
    color: var(--ssf-link-hover);
  }


  /* =========================================================
     NEWSLETTER
     ========================================================= */

  #{{ footer_uid }} .ssf__newsletter-column {
    width: 100%;
    max-width: var(--ssf-newsletter-width);

    justify-self: end;
  }

  #{{ footer_uid }} .ssf__newsletter-form {
    margin: 0;
  }

  #{{ footer_uid }} .ssf__newsletter-field {
    display: flex;
    align-items: stretch;

    width: 100%;
    height: 38px;

    overflow: hidden;

    border: 1px solid var(--ssf-input-border);
    border-radius: 5px;

    background: #ffffff;
  }

  #{{ footer_uid }} .ssf__email-input {
    flex: 1;

    min-width: 0;

    padding: 0 12px;

    border: 0;
    outline: 0;
    box-shadow: none;

    background: transparent;

    color: #444444;

    font-size: 14px;
  }

  #{{ footer_uid }} .ssf__email-input::placeholder {
    color: #777777;
    opacity: 1;
  }

  #{{ footer_uid }} .ssf__subscribe {
    flex: 0 0 auto;

    padding: 0 18px;

    border: 0;

    background: transparent;

    color: #000000;

    font-size: 11px;
    font-weight: 700;

    text-transform: uppercase;

    cursor: pointer;
  }

  #{{ footer_uid }} .ssf__subscribe:hover {
    opacity: 0.7;
  }


  /* =========================================================
     AGREEMENT
     ========================================================= */

  #{{ footer_uid }} .ssf__agreement {
    display: flex;
    align-items: flex-start;

    gap: 6px;

    margin-top: 10px;

    cursor: pointer;
  }

  #{{ footer_uid }} .ssf__agreement-checkbox {
    width: 13px;
    height: 13px;

    margin: 2px 0 0;

    flex: 0 0 auto;
  }

  #{{ footer_uid }} .ssf__agreement-text {
    font-size: 12px;
    line-height: 1.35;

    color: var(--ssf-text-color);
  }

  #{{ footer_uid }} .ssf__agreement-text a {
    color: inherit;

    text-decoration: none;
  }

  #{{ footer_uid }} .ssf__agreement-text a:hover {
    text-decoration: underline;
  }


  /* =========================================================
     SOCIAL ICONS
     ========================================================= */

  #{{ footer_uid }} .ssf__socials {
    display: flex;
    align-items: center;

    gap: 8px;

    margin-top: 18px;
  }

  #{{ footer_uid }} .ssf__social {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 20px;
    height: 20px;

    color: #6f7d88;

    text-decoration: none;
  }

  #{{ footer_uid }} .ssf__social svg {
    display: block;

    width: 100%;
    height: 100%;

    fill: currentColor;
  }

  #{{ footer_uid }} .ssf__social:hover {
    color: #111111;
  }


  /* =========================================================
     FORM MESSAGES
     ========================================================= */

  #{{ footer_uid }} .ssf__form-message {
    margin: 8px 0 0;

    font-size: 12px;
    line-height: 1.4;
  }

  #{{ footer_uid }} .ssf__form-message--success {
    color: #2a6f37;
  }

  #{{ footer_uid }} .ssf__form-message--error {
    color: #a12626;
  }


  /* =========================================================
     BOTTOM STRIP
     ========================================================= */

  #{{ footer_uid }} .ssf__bottom {
    position: relative;

    background: var(--ssf-bottom-bg);

    border-top: 1px solid rgba(0, 0, 0, 0.05);

    box-shadow:
      0 -2px 7px
      rgba(0, 0, 0, calc(var(--ssf-shadow-opacity) * 0.8));
  }

  #{{ footer_uid }} .ssf__bottom-container {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 30px;

    width: min(
      calc(100% - (var(--ssf-side-padding) * 2)),
      var(--ssf-max-width)
    );

    margin-inline: auto;

    padding-top: var(--ssf-bottom-padding-y);
    padding-bottom: var(--ssf-bottom-padding-y);
  }


  /* =========================================================
     LEGAL TEXT
     ========================================================= */

  #{{ footer_uid }} .ssf__legal {
    flex: 1;
  }

  #{{ footer_uid }} .ssf__copyright {
    font-size: 12px;
    line-height: 1.4;

    color: #65717a;
  }

  #{{ footer_uid }} .ssf__abn {
    margin-top: 2px;

    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;

    color: #65717a;
  }


  /* =========================================================
     PAYMENT LOGOS
     ========================================================= */

  #{{ footer_uid }} .ssf__payments {
    flex: 0 0 auto;
  }

  #{{ footer_uid }} .ssf__payment-image {
    display: block;

    width: auto;
    max-width: {{ section.settings.payment_image_width }}px;

    height: auto;
    max-height: 100px;

    object-fit: contain;
  }


  /* =========================================================
     TABLET
     ========================================================= */

  @media screen and (max-width: 989px) {

    #{{ footer_uid }} .ssf__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));

      gap: 38px 44px;
    }

    #{{ footer_uid }} .ssf__newsletter-column {
      max-width: none;

      justify-self: stretch;
    }

  }


  /* =========================================================
     MOBILE
     ========================================================= */

  @media screen and (max-width: 599px) {

    #{{ footer_uid }} .ssf__container {
      width: calc(
        100% - (var(--ssf-mobile-side-padding) * 2)
      );

      padding-top: var(--ssf-mobile-padding-top);
      padding-bottom: var(--ssf-mobile-padding-bottom);
    }

    #{{ footer_uid }} .ssf__grid {
      grid-template-columns: 1fr;

      gap: 30px;
    }

    #{{ footer_uid }} .ssf__heading {
      margin-bottom: 12px;
    }

    #{{ footer_uid }} .ssf__links li + li {
      margin-top: 10px;
    }

    #{{ footer_uid }} .ssf__newsletter-field {
      height: 42px;
    }

    #{{ footer_uid }} .ssf__bottom-container {
      flex-direction: column;
      align-items: flex-start;

      width: calc(
        100% - (var(--ssf-mobile-side-padding) * 2)
      );

      gap: 14px;
    }

    #{{ footer_uid }} .ssf__payments {
      width: 100%;
    }

    #{{ footer_uid }} .ssf__payment-image {
      max-width: min(
        100%,
        {{ section.settings.payment_image_width }}px
      );
    }

  }


  /* =========================================================
     ACCESSIBILITY
     ========================================================= */

  #{{ footer_uid }} a:focus-visible,
  #{{ footer_uid }} button:focus-visible,
  #{{ footer_uid }} input:focus-visible {
    outline: 2px solid #111111;
    outline-offset: 2px;
  }

  #{{ footer_uid }} .visually-hidden {
    position: absolute !important;

    width: 1px !important;
    height: 1px !important;

    padding: 0 !important;
    margin: -1px !important;

    overflow: hidden !important;

    clip: rect(0, 0, 0, 0) !important;

    white-space: nowrap !important;

    border: 0 !important;
  }

</style>


{% schema %}
{
  "name": "Salon Support Footer",
  "tag": "section",
  "class": "salon-support-footer-section",

  "settings": [

    {
      "type": "header",
      "content": "Menus"
    },

    {
      "type": "text",
      "id": "service_heading",
      "label": "Service heading",
      "default": "Service"
    },

    {
      "type": "link_list",
      "id": "service_menu",
      "label": "Service menu"
    },

    {
      "type": "text",
      "id": "about_heading",
      "label": "About Us heading",
      "default": "About Us"
    },

    {
      "type": "link_list",
      "id": "about_menu",
      "label": "About Us menu"
    },

    {
      "type": "text",
      "id": "information_heading",
      "label": "Information heading",
      "default": "Information"
    },

    {
      "type": "link_list",
      "id": "information_menu",
      "label": "Information menu"
    },


    {
      "type": "header",
      "content": "Newsletter"
    },

    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Stay In Touch"
    },

    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Email"
    },

    {
      "type": "text",
      "id": "subscribe_label",
      "label": "Subscribe button label",
      "default": "SUBSCRIBE"
    },

    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for subscribing."
    },

    {
      "type": "range",
      "id": "newsletter_width",
      "label": "Newsletter maximum width",
      "min": 260,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 320
    },


    {
      "type": "header",
      "content": "Agreement"
    },

    {
      "type": "checkbox",
      "id": "show_agreement",
      "label": "Show agreement checkbox",
      "default": true
    },

    {
      "type": "text",
      "id": "agreement_prefix",
      "label": "Agreement text before Terms",
      "default": "I have read and agree to"
    },

    {
      "type": "text",
      "id": "terms_label",
      "label": "Terms label",
      "default": "Terms & Conditions"
    },

    {
      "type": "url",
      "id": "terms_link",
      "label": "Terms link"
    },

    {
      "type": "text",
      "id": "agreement_middle",
      "label": "Text between Terms and Privacy",
      "default": "and"
    },

    {
      "type": "text",
      "id": "privacy_label",
      "label": "Privacy label",
      "default": "Privacy Policy"
    },

    {
      "type": "url",
      "id": "privacy_link",
      "label": "Privacy Policy link"
    },


    {
      "type": "header",
      "content": "Social links"
    },

    {
      "type": "text",
      "id": "email_link",
      "label": "Email address"
    },

    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },

    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },


    {
      "type": "header",
      "content": "Bottom bar"
    },

    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "Copyright © 2026 Salon Support Pty Ltd."
    },

    {
      "type": "text",
      "id": "abn_text",
      "label": "ABN text",
      "default": "ABN: 42 064 168 154"
    },

    {
      "type": "image_picker",
      "id": "payment_image",
      "label": "Payment methods image"
    },

    {
  "type": "range",
  "id": "payment_image_width",
  "label": "Payment image width",
  "min": 300,
  "max": 1000,
  "step": 10,
  "unit": "px",
  "default": 650
},

    {
      "type": "range",
      "id": "bottom_strip_padding",
      "label": "Bottom strip vertical padding",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },


    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Main background",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "bottom_background_color",
      "label": "Bottom strip background",
      "default": "#F7F8F9"
    },

    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#17212B"
    },

    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#7B7F82"
    },

    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#111111"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
