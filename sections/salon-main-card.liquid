{%- comment -%}
  ============================================================
  SALON SUPPORT - FEATURED CATEGORIES
  Main card version with unique class names
  ============================================================
{%- endcomment -%}

{%- liquid
  assign section_uid = 'SalonMainCards-' | append: section.id
-%}

<section
  id="{{ section_uid }}"
  class="main-card-section"
  style="
    --mc-bg-color: {{ section.settings.background_color }};
    --mc-heading-color: {{ section.settings.heading_color }};
    --mc-card-text-color: {{ section.settings.card_text_color }};

    --mc-content-width: {{ section.settings.content_max_width }}px;

    --mc-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --mc-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --mc-padding-side-desktop: {{ section.settings.padding_side_desktop }}px;

    --mc-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --mc-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --mc-padding-side-mobile: {{ section.settings.padding_side_mobile }}px;

    --mc-heading-size: {{ section.settings.heading_font_size }}px;
    --mc-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
    --mc-heading-letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    --mc-heading-bottom-gap: {{ section.settings.heading_bottom_gap }}px;

    --mc-column-gap: {{ section.settings.column_gap }}px;
    --mc-row-gap: {{ section.settings.row_gap }}px;

    --mc-card-height: {{ section.settings.card_height }}px;
    --mc-card-height-tablet: {{ section.settings.card_height_tablet }}px;
    --mc-card-height-mobile: {{ section.settings.card_height_mobile }}px;

    --mc-card-radius: {{ section.settings.card_radius }}px;

    --mc-title-size: {{ section.settings.card_title_font_size }}px;
    --mc-title-size-tablet: {{ section.settings.card_title_font_size_tablet }}px;
    --mc-title-size-mobile: {{ section.settings.card_title_font_size_mobile }}px;

    --mc-title-left: {{ section.settings.card_title_left }}px;
    --mc-title-bottom: {{ section.settings.card_title_bottom }}px;

    --mc-title-shadow-x: {{ section.settings.shadow_x }}px;
    --mc-title-shadow-y: {{ section.settings.shadow_y }}px;
    --mc-title-shadow-blur: {{ section.settings.shadow_blur }}px;
    --mc-title-shadow-color: {{ section.settings.shadow_color }};
  "
>
  <div class="main-card-background">
    {% if section.settings.background_image != blank %}
      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          class: 'main-card-background__image',
          loading: 'lazy',
          widths: '750, 1000, 1400, 1800, 2200, 2400',
          alt: ''
      }}
    {% endif %}
  </div>

  <div class="main-card-container">
    {% if section.settings.heading != blank %}
      <div class="main-card-heading-wrap">
        <h2 class="main-card-heading">
          {{ section.settings.heading }}
        </h2>
      </div>
    {% endif %}

    <div class="main-card-grid">
      {% for block in section.blocks %}
        {% if block.type == 'category' %}
          {% liquid
            assign card_link = block.settings.link
            assign image_position = block.settings.image_position
          %}

          <a
            class="main-category-card"
            href="{{ card_link | default: '#' }}"
            {{ block.shopify_attributes }}
          >
            <div
              class="main-category-card__media"
              style="--mc-image-position: {{ image_position }};"
            >
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'main-category-card__image',
                    loading: 'lazy',
                    widths: '360, 540, 720, 900, 1200',
                    sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                    alt: block.settings.title
                }}
              {% else %}
                <div class="main-category-card__placeholder">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            {% if block.settings.title != blank %}
              <div class="main-category-card__content">
                {% if block.settings.desc != blank %}
                  <span class="main-category-card__desc">
                    {{ block.settings.desc }}
                  </span>
                {% endif %}

                <span class="main-category-card__title">
                  {{ block.settings.title }}
                </span>
              </div>
            {% endif %}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #{{ section_uid }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--mc-bg-color);
  }

  #{{ section_uid }} *,
  #{{ section_uid }} *::before,
  #{{ section_uid }} *::after {
    box-sizing: border-box;
  }

  #{{ section_uid }} .main-card-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  #{{ section_uid }} .main-card-background__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 1;
  }

  #{{ section_uid }} .main-card-container {
    position: relative;
    z-index: 1;
    width: min(
      calc(100% - (var(--mc-padding-side-desktop) * 2)),
      var(--mc-content-width)
    );
    margin-inline: auto;
    padding-top: var(--mc-padding-top-desktop);
    padding-bottom: var(--mc-padding-bottom-desktop);
  }

  #{{ section_uid }} .main-card-heading-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--mc-heading-bottom-gap);
    text-align: center;
  }

  #{{ section_uid }} .main-card-heading {
    margin: 0;
    padding: 0;
    color: var(--mc-heading-color);
    font-family: var(--font-h2--family);
    font-size: var(--mc-heading-size);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: var(--mc-heading-letter-spacing);
    text-align: center;
    text-transform: uppercase;
  }

  #{{ section_uid }} .main-card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--mc-column-gap);
    row-gap: var(--mc-row-gap);
    margin-inline: auto;
    max-width: 920px;
    justify-content: center;

  }

  #{{ section_uid }} .main-category-card {
    position: relative;
    display: block;
    width: 100%;
    height: var(--mc-card-height);
    overflow: hidden;
    border-radius: 15px;
    border-bottom-right-radius: 60px;
    color: inherit;
    text-decoration: none;
    background: #f5f5f5;
    isolation: isolate;
    transition: border-radius 0.6s cubic-bezier(0.075, 0.82, 0.165, 1);
  }

  #{{ section_uid }} .main-category-card:focus-visible {
    outline: 2px solid #111111;
    outline-offset: 3px;
  }

  #{{ section_uid }} .main-category-card__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #{{ section_uid }} .main-category-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--mc-image-position, center);
    transition: transform 260ms ease;
  }

  #{{ section_uid }} .main-category-card:hover {
    border-bottom-right-radius: 15px !important;
  }

  #{{ section_uid }} .main-category-card:hover
    .main-category-card__image {
    transform: scale(1.025);
  }

  #{{ section_uid }} .main-category-card__placeholder {
    width: 100%;
    height: 100%;
    background: #eeeeee;
  }

  #{{ section_uid }} .main-category-card__placeholder svg {
    width: 100%;
    height: 100%;
  }

  #{{ section_uid }} .main-category-card__content {
    position: absolute;
    left: var(--mc-title-left);
    right: 18px;
    bottom: var(--mc-title-bottom);
    z-index: 2;
  }

  #{{ section_uid }} .main-category-card__title {
    display: flex;
    color: var(--mc-card-text-color);
    font-family: var(--font-h2--family);
    font-size: 40px;
    font-weight: 700;
    line-height: 1.15;
    text-transform: uppercase;
    text-shadow:
      var(--mc-title-shadow-x)
      var(--mc-title-shadow-y)
      var(--mc-title-shadow-blur)
      var(--mc-title-shadow-color);
  }

  #{{ section_uid }} .main-category-card__desc {
    display: flex;
    width: 65%;
    color: var(--mc-card-text-color);
    font-family: var(--font-h2--family);
    font-size: 14px !important;
    line-height: 1.3;
    text-transform: none !important;
    text-shadow:
      var(--mc-title-shadow-x)
      var(--mc-title-shadow-y)
      var(--mc-title-shadow-blur)
      var(--mc-title-shadow-color);
  }

  @media screen and (max-width: 989px) and (min-width: 750px) {
    #{{ section_uid }} .main-card-container {
      width: min(
        calc(100% - 40px),
        var(--mc-content-width)
      );
    }

    #{{ section_uid }} .main-card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ section_uid }} .main-category-card {
      height: var(--mc-card-height-tablet);
    }

    #{{ section_uid }} .main-category-card__title {
      font-size: var(--mc-title-size-tablet);
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_uid }} .main-card-container {
      width: calc(
        100% - (var(--mc-padding-side-mobile) * 2)
      );
      padding-top: var(--mc-padding-top-mobile);
      padding-bottom: var(--mc-padding-bottom-mobile);
    }

    #{{ section_uid }} .main-card-heading-wrap {
      margin-bottom: clamp(
        22px,
        6vw,
        var(--mc-heading-bottom-gap)
      );
    }

    #{{ section_uid }} .main-card-heading {
      font-size: var(--mc-heading-size-mobile);
    }

    #{{ section_uid }} .main-card-grid {
      grid-template-columns: 1fr;
      column-gap: 0;
      row-gap: clamp(
        14px,
        4vw,
        var(--mc-row-gap)
      );
    }

    #{{ section_uid }} .main-category-card {
      height: var(--mc-card-height-mobile);
    }

    #{{ section_uid }} .main-category-card__content {
      left: clamp(
        16px,
        5vw,
        var(--mc-title-left)
      );
      right: 16px;
      bottom: clamp(
        15px,
        4vw,
        var(--mc-title-bottom)
      );
    }

    #{{ section_uid }} .main-category-card__title {
      font-size: var(--mc-title-size-mobile);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_uid }} .main-category-card__image {
      transition: none;
    }

    #{{ section_uid }} .main-category-card:hover
      .main-category-card__image {
      transform: none;
    }
  }
</style>

{% schema %}
{
  "name": "Salon Featured Categories",
  "tag": "section",
  "class": "salon-main-card-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FEATURED CATEGORIES"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fallback background color",
      "default": "#F3E4F2"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 900,
      "max": 1500,
      "step": 10,
      "unit": "px",
      "default": 1210
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 8,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row gap",
      "min": 8,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop padding top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop padding bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "padding_side_desktop",
      "label": "Desktop side padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile padding top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_side_mobile",
      "label": "Mobile side padding",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#202A35"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Desktop heading size",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 21
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Mobile heading size",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading letter spacing",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "heading_bottom_gap",
      "label": "Gap below heading",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 38
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Desktop card height",
      "min": 180,
      "max": 420,
      "step": 5,
      "unit": "px",
      "default": 265
    },
    {
      "type": "range",
      "id": "card_height_tablet",
      "label": "Tablet card height",
      "min": 180,
      "max": 360,
      "step": 5,
      "unit": "px",
      "default": 245
    },
    {
      "type": "range",
      "id": "card_height_mobile",
      "label": "Mobile card height",
      "min": 170,
      "max": 340,
      "step": 5,
      "unit": "px",
      "default": 220
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Card titles"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card title color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "card_title_font_size",
      "label": "Desktop title size",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 31
    },
    {
      "type": "range",
      "id": "card_title_font_size_tablet",
      "label": "Tablet title size",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 27
    },
    {
      "type": "range",
      "id": "card_title_font_size_mobile",
      "label": "Mobile title size",
      "min": 16,
      "max": 34,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_title_left",
      "label": "Title left spacing",
      "min": 8,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_title_bottom",
      "label": "Title bottom spacing",
      "min": 8,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Title shadow"
    },
    {
      "type": "range",
      "id": "shadow_x",
      "label": "Shadow horizontal",
      "min": -10,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "shadow_y",
      "label": "Shadow vertical",
      "min": -10,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "range",
      "id": "shadow_blur",
      "label": "Shadow blur",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 5
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Shadow color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "desc",
          "label": "Category desc"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category title",
          "default": "CATEGORY"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category link"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "options": [
            {
              "value": "center center",
              "label": "Center"
            },
            {
              "value": "center top",
              "label": "Top"
            },
            {
              "value": "center bottom",
              "label": "Bottom"
            },
            {
              "value": "left center",
              "label": "Left"
            },
            {
              "value": "right center",
              "label": "Right"
            }
          ],
          "default": "center center"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Salon card",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "BRAZILIAN BOND BUILDER"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "OLIGO PRO BLACKLIGHT"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "HAIR COLOUR"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "HAIR CARE"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "DEVELOPERS"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "LIGHTENERS"
          }
        }
      ]
    }
  ]
}
{% endschema %}